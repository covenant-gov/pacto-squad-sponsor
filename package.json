{
  "name": "pacto-squad-sponsor",
  "version": "0.1.0",
  "description": "Collective squad-scoped gas sponsorship for Pacto",
  "homepage": "https://github.com/covenant-gov/pacto-squad-sponsor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/covenant-gov/pacto-squad-sponsor.git"
  },
  "license": "MIT",
  "author": "Pacto",
  "scripts": {
    "build": "forge build",
    "build:optimized": "FOUNDRY_PROFILE=optimized forge build",
    "commit": "pnpm lint:fix && pnpm lint:natspec && pnpm test:unit && pnpm test:integration",
    "coverage": "forge coverage --ir-minimum --report summary --report lcov --match-path 'test/unit/*' --no-match-coverage 'script/|test/integration/'",
    "deploy:arbitrum": "bash -c 'source .env && forge script Deploy --rpc-url arbitrum --account $ARBITRUM_DEPLOYER_NAME --broadcast --verify --chain arbitrum -vvvvv'",
    "deploy:mainnet": "bash -c 'source .env && forge script Deploy --rpc-url mainnet --account $MAINNET_DEPLOYER_NAME --broadcast --verify --chain mainnet -vvvvv'",
    "deploy:sepolia": "bash -c 'source .env && forge script Deploy --rpc-url sepolia --account $SEPOLIA_DEPLOYER_NAME --broadcast --verify --chain sepolia -vvvvv'",
    "lint:bulloak": "find test/unit -name '*.tree' | xargs bulloak check",
    "lint:check": "forge fmt --check && pnpm lint:sol",
    "lint:fix": "forge fmt && pnpm lint:sol --fix && sort-package-json",
    "lint:natspec": "lintspec",
    "lint:sol": "solhint 'src/**/*.sol' 'script/**/*.sol' 'test/**/*.sol'",
    "prepare": "husky",
    "test": "forge test -vvv",
    "test:bulloak:fix": "bulloak check --fix ./**/*.tree",
    "test:bulloak:scaffold": "bulloak scaffold -wS ./**/*.tree",
    "test:integration": "forge test --match-contract E2E --fork-url mainnet --fork-block-number 22900000 -vvv",
    "test:unit": "forge test --match-contract Unit -vvv",
    "test:unit:deep": "FOUNDRY_FUZZ_RUNS=5000 pnpm test:unit"
  },
  "lint-staged": {
    "*.{js,css,md,ts,sol}": "forge fmt",
    "(src|script|test)/**/*.sol": "pnpm lint:sol --fix",
    "src/**/*.sol": "bash scripts/lintspec.sh",
    "test/unit/**/*.tree": "pnpm lint:bulloak",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@openzeppelin/contracts": "5.1.0",
    "hats-core": "github:Hats-Protocol/hats-protocol",
    "pacto-gov": "github:covenant-gov/pacto-gov"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "forge-std": "github:foundry-rs/forge-std#v1.9.2",
    "husky": ">=9",
    "lint-staged": ">=16",
    "solhint-community": "4.0.1",
    "solhint-config-wonderland": "0.0.1",
    "sort-package-json": "3.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "solidity-foundry-boilerplate"
    ]
  }
}
