# Private configuration only — never commit `.env`
# Public addresses (EntryPoint, Hats, deployments) → script/Constants.sol

# RPC endpoints (often include provider API keys in the URL)
MAINNET_RPC=
SEPOLIA_RPC=
ARBITRUM_RPC=

# Foundry keystore account names (cast wallet import)
MAINNET_DEPLOYER_NAME=
SEPOLIA_DEPLOYER_NAME=
ARBITRUM_DEPLOYER_NAME=

# API keys
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
