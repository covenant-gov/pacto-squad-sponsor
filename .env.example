# Private configuration only — never commit `.env`
# Public addresses (EntryPoint, deployments) → script/Constants.sol
# Hats is baked into sponsor bytecode (SquadSponsorConstants.HATS_ADDRESS), not a deploy arg

# RPC endpoints (often include provider API keys in the URL)
# Used by foundry.toml [rpc_endpoints] and `pnpm test:integration` (`--fork-url mainnet`)
MAINNET_RPC=
SEPOLIA_RPC=
ARBITRUM_RPC=

# Foundry keystore account names (cast wallet import) — for `forge script` deploy only (`pnpm deploy:*`), not E2E tests
MAINNET_DEPLOYER_NAME=
SEPOLIA_DEPLOYER_NAME=
ARBITRUM_DEPLOYER_NAME=

# API keys
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
